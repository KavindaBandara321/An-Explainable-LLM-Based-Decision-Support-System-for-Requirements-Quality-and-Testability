# Copy to api/.env (gitignored) and adjust. Never commit api/.env.

# --- SQL Server in Docker (docker compose up -d) ---
DB_SERVER=127.0.0.1,1433
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ChangeMe!Str0ng_Pass
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Windows LocalDB alternative (comment out the block above) ---
# DB_SERVER=(localdb)\MSSQLLocalDB
# DB_USER=
# DB_PASSWORD=
# DB_DRIVER=ODBC Driver 17 for SQL Server

# Databases. The test database is separate and is wiped by the tests; its name must end in "_test".
DB_NAME=story_quality
DB_TEST_NAME=story_quality_test

# Only this origin is allowed by CORS.
CORS_ORIGIN=http://localhost:4200
